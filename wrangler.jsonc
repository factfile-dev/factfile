// Cloudflare Workers config for factfile.dev: serves the static site in ./site, and runs
// worker/index.js for the pages (Markdown negotiation and headers) and /api/* (the fetch relay).
// Built from site-src/ (cd site-src && npm run build); nothing is built on Cloudflare.
// run_worker_first must list every page: the build checks it against site/pages.json.
{
  "name": "factfile",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/", "/what-is-factfile", "/generate", "/spec", "/tools", "/factfile", "/about", "/support"]
  }
}
